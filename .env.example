# Used by `docker compose up` (compose.yaml), which auto-loads a plain `.env`
# file in this directory — distinct from `.env.local`/`.env.local.example`,
# which `next dev` uses instead. Copy this to `.env` and fill it in.

# Generate with: openssl rand -base64 32 — required, compose refuses to start without it.
SESSION_SECRET=

# Defaults to http://host.docker.internal:8080, reaching a backend running on
# the host outside this compose file. Override if clients-service is deployed
# elsewhere.
BACKEND_API_URL=
