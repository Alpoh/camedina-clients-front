# Generate with: openssl rand -base64 32
# Falls back to an insecure dev-only default if unset — set this before deploying anywhere real.
SESSION_SECRET=

# Spring Boot backend base URL. Falls back to http://localhost:8080 if unset.
BACKEND_API_URL=http://localhost:8080

# Set to "true" only if BACKEND_API_URL is https:// with a self-signed cert
# (e.g. local/staging TLS). Ignored in production — never set it there.
BACKEND_ALLOW_SELF_SIGNED_CERT=false
